{
  "name": "dst-cookpot-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "ingredient-stats": "node scripts/ingredient_stats.mjs",
    "validate": "node scripts/validate.mjs",
    "validate-rules": "node scripts/validate_rules.mjs",
    "validate-examples": "node scripts/validate_examples.mjs",
    "cook-examples": "node scripts/cook_examples.mjs",
    "snapshot-visits": "node scripts/snapshot_visits.mjs",
    "sitemap": "node scripts/generate_sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate-random": "node scripts/validate_random_examples.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
